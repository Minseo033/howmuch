// 얼마에요 인터랙티브 로그인 + 전 기능 클릭 테스트
// 보이는 브라우저를 띄워 사용자가 카카오 로그인을 직접 하고,
// 로그인된 세션으로 모든 기능을 하나하나 클릭하며 검증한다.
const { chromium } = require('playwright');
const fs = require('fs');
const path = require('path');

const BASE = process.argv[2] || 'https://howmuch-zeta.vercel.app';
const SHOTS = path.join(__dirname, 'shots');
fs.mkdirSync(SHOTS, { recursive: true });

const results = [];
const consoleErrors = [];
const failedRequests = [];
const API_LOG = [];

function report(name, ok, detail = '') {
  results.push({ name, ok, detail });
  console.log((ok ? 'PASS' : 'FAIL') + ' ' + name + (detail ? ' — ' + detail : ''));
}
async function sem(page) { return page.evaluate(() => document.body.innerText || ''); }
async function shot(page, name) {
  try { await page.screenshot({ path: path.join(SHOTS, name.replace(/[^a-z0-9가-힣]/gi, '_') + '.png') }); } catch (_) {}
}
async function textClick(page, text, wait = 3000) {
  try { await page.click('text=' + text, { timeout: 6000 }); await page.waitForTimeout(wait); return true; }
  catch (_) { return false; }
}
async function enableSem(page) {
  try { await page.evaluate(() => { const ph = document.querySelector('flt-semantics-placeholder'); if (ph) ph.click(); }); await page.waitForTimeout(1200); } catch (_) {}
}

(async () => {
  // headless: false → 보이는 브라우저 (사용자가 로그인)
  const browser = await chromium.launch({ headless: false, args: ['--window-size=430,900'] });
  const ctx = await browser.newContext({
    viewport: { width: 390, height: 844 },
    deviceScaleFactor: 1,
    permissions: ['geolocation'],
    geolocation: { latitude: 37.5665, longitude: 126.9780 },
  });
  await ctx.addInitScript(() => {
    try { localStorage.setItem('flutter.onboarding_completed', 'true'); } catch (_) {}
  });
  const page = await ctx.newPage();
  page.on('console', (m) => { if (m.type() === 'error') consoleErrors.push(m.text().slice(0, 200)); });
  page.on('pageerror', (e) => consoleErrors.push('PAGEERROR: ' + String(e).slice(0, 200)));
  page.on('requestfailed', (r) => failedRequests.push(r.url().slice(0, 110)));
  page.on('response', (r) => {
    try { const u = r.url(); if (u.includes('onrender.com') && u.includes('/api/')) API_LOG.push(r.status() + ' ' + (u.split('onrender.com')[1] || '').split('?')[0]); } catch (_) {}
  });

  console.log('=== 로그인 대기: 브라우저에서 카카오 로그인해 주세요 (최대 120초) ===');
  await page.goto(BASE + '/#/login', { waitUntil: 'domcontentloaded', timeout: 45000 });
  await page.waitForTimeout(6000);
  await enableSem(page);

  // 로그인 완료 대기: localStorage에 토큰이 생길 때까지 폴링
  let loggedIn = false;
  for (let i = 0; i < 40; i++) {
    const tok = await page.evaluate(() => {
      try { return localStorage.getItem('flutter.howmuch_session_token') || ''; } catch (_) { return ''; }
    });
    if (tok && tok.length > 20) { loggedIn = true; break; }
    await page.waitForTimeout(3000);
  }
  if (!loggedIn) {
    console.log('FAIL: 로그인 시간 초과');
    process.exit(1);
  }
  console.log('PASS 로그인 완료 (토큰이 localStorage에 저장됨)\n');
  await page.waitForTimeout(4000);
  await enableSem(page);

  // 로그인 후 현재 화면 (홈으로 이동했을 것)
  let t = await sem(page);
  await shot(page, 'B1_after_login');
  report('01_로그인후_화면', !t.includes('카카오로 계속하기'), t.replace(/\n+/g, ' | ').slice(0, 150));

  // 2. 절약 리포트 (실데이터 확인)
  await page.goto(BASE + '/#/savings/dashboard', { waitUntil: 'domcontentloaded', timeout: 30000 });
  await page.waitForTimeout(5000); await enableSem(page);
  t = await sem(page);
  await shot(page, 'B2_savings');
  report('02_절약대시보드', t.includes('절약 리포트') && t.includes('절약 금액'), t.replace(/\n+/g, ' | ').slice(0, 200));
  report('02b_실데이터(목업아님)', !t.includes('2026.05'), t.replace(/\n+/g, ' | ').slice(0, 200));

  // 3. 절약 상세 내역
  report('03_상세내역_클릭', await textClick(page, '절약 상세 내역', 4000), '');
  t = await sem(page);
  await shot(page, 'B3_detail');
  report('03b_상세내역_화면', t.includes('누적 절약') || t.includes('절약 내역'), t.replace(/\n+/g, ' | ').slice(0, 150));
  await page.goBack(); await page.waitForTimeout(2500);

  // 4. 목표 설정
  report('04_목표설정_클릭', await textClick(page, '목표 설정', 4000), '');
  t = await sem(page);
  await shot(page, 'B4_goal');
  report('04b_목표설정_화면', t.includes('이번 달 절약 목표') || t.includes('절약 목표'), t.replace(/\n+/g, ' | ').slice(0, 150));
  await page.goBack(); await page.waitForTimeout(2500);

  // 5. 마이페이지 (실제 프로필)
  await page.goto(BASE + '/#/mypage', { waitUntil: 'domcontentloaded', timeout: 30000 });
  await page.waitForTimeout(5000); await enableSem(page);
  t = await sem(page);
  await shot(page, 'B5_my');
  report('05_마이페이지', t.includes('마이'), t.replace(/\n+/g, ' | ').slice(0, 200));
  report('05b_실제프로필(목업아님)', !t.includes('절약왕 민서'), t.replace(/\n+/g, ' | ').slice(0, 200));

  // 6. 내 리뷰 (로그인 상태)
  report('06_내리뷰_클릭', await textClick(page, '내 리뷰', 5000), '');
  t = await sem(page);
  await shot(page, 'B6_reviews');
  report('06b_내리뷰_로그인', !t.includes('로그인이 필요해요'), t.replace(/\n+/g, ' | ').slice(0, 150));
  await page.goBack(); await page.waitForTimeout(2500);

  // 7. 찜한 매장
  report('07_찜한매장_클릭', await textClick(page, '찜한 매장', 5000), '');
  t = await sem(page);
  await shot(page, 'B7_fav');
  report('07b_찜한매장_화면', t.includes('찜한 매장'), t.replace(/\n+/g, ' | ').slice(0, 150));
  await page.goBack(); await page.waitForTimeout(2500);

  // 8. 내 제보
  report('08_내제보_클릭', await textClick(page, '내 제보', 5000), '');
  t = await sem(page);
  await shot(page, 'B8_reports');
  report('08b_내제보_화면', t.includes('제보') || t.length > 10, t.replace(/\n+/g, ' | ').slice(0, 150));

  // 9. 홈 (매장 지도)
  await page.goto(BASE + '/#/home', { waitUntil: 'domcontentloaded', timeout: 30000 });
  await page.waitForTimeout(5000); await enableSem(page);
  t = await sem(page);
  await shot(page, 'B9_home');
  report('09_홈지도', t.includes('AI') || t.includes('추천') || t.includes('50m'), t.replace(/\n+/g, ' | ').slice(0, 120));

  console.log('\n=== API 호출 (로그인 후, dedup) ===');
  [...new Set(API_LOG)].slice(0, 30).forEach((e) => console.log('  ' + e));
  if (API_LOG.length === 0) console.log('  (없음)');

  console.log('\n=== console errors (dedup) ===');
  [...new Set(consoleErrors)].slice(0, 15).forEach((e) => console.log('  ' + e));
  if (consoleErrors.length === 0) console.log('  none');

  console.log('\n=== failed requests (dedup) ===');
  [...new Set(failedRequests)].slice(0, 15).forEach((e) => console.log('  ' + e));
  if (failedRequests.length === 0) console.log('  none');

  const pass = results.filter((r) => r.ok).length;
  console.log('\n=== RESULT: ' + pass + '/' + results.length + ' passed ===');
  await browser.close();
  process.exit(results.every((r) => r.ok) ? 0 : 1);
})().catch((e) => { console.error('FATAL', e); process.exit(2); });